# --- Python derived artifacts ---
__pycache__/
*.pyc
*.pyo
*.egg-info/
.pytest_cache/

# --- Virtual environments ---
.venv/
venv/

# --- Secrets (NEVER commit) ---
.env
*.key

# --- IDE / editor settings ---
.vscode/
.idea/

# --- Audio artifacts (large binaries, may contain session audio) ---
*.wav
*.mp3
*.flac

# --- Logs and temporary files ---
*.log
logs/
tmp/
*.tmp

# --- Derived knowledge indexes (rebuildable from Markdown, ADR-006) ---
*.db
*.sqlite
*.sqlite3
