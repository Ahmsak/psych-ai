# Sprint 17 LLM analysis configuration (tools/llm_smoke.py, app runtime).
# Copy this file to tools/.env (or project root .env) and fill in the key.
# NEVER commit a real .env — it must stay out of git.

# Gemini API key (required by the gemini provider).
GEMINI_API_KEY=your_gemini_api_key_here

# Active LLM provider (developer-only; the UI does NOT select a provider).
# Registered keys: gemini (default).
PSYCHAI_LLM_PROVIDER=gemini

# Model id override (optional). Default per provider:
#   gemini -> gemini-2.5-flash (cheap, 1M-token context, good for transcripts)
# PSYCHAI_LLM_MODEL=gemini-2.5-flash
